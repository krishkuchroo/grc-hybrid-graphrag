{
  "name": "@grc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "sh -c '[ \"$1\" = -- ] && shift; exec vitest run \"$@\"' vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "start:api": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./src/ts-resolve.ts src/main.api.ts",
    "start:worker": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./src/ts-resolve.ts src/main.worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@grc/shared": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "better-auth": "1.7.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
