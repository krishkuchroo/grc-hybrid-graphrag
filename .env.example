# Copy to .env (git-ignored, D57). Variable names only, never values.
# `pnpm setup:secrets` writes .env and fills every secret with a random value.

# Postgres superuser password for the grc-postgres container (D13).
POSTGRES_PASSWORD=

# Postgres accounts (D57, D73). setup:secrets fills both with a fresh random password:
# DATABASE_URL_APP is the restricted runtime account, DATABASE_URL_MIGRATE the migration account.
DATABASE_URL_APP=
DATABASE_URL_MIGRATE=

# Neo4j accounts our code uses (D57, D73).
NEO4J_ADMIN_PASSWORD=
NEO4J_WRITER_PASSWORD=
# The 28 read-only graph query accounts' passwords derive from this one secret (M0-005, D73).
NEO4J_QUERY_SECRET=

# SeaweedFS's one backend-only service key (D57), used by the API and worker.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The Neo4j Desktop `neo4j` account's password. You fill this in yourself;
# setup:secrets leaves it empty. Only `pnpm setup:neo4j` uses it.
NEO4J_DESKTOP_PASSWORD=

# Better Auth's signing secret for sessions (D49, D165). setup:secrets fills it.
BETTER_AUTH_SECRET=

# The one password every `pnpm seed:demo` user signs in with (D114). setup:secrets fills it;
# at least 12 characters (D49). Never printed.
DEMO_USER_PASSWORD=
