# Copy to .env (git-ignored, D57). Variable names only, never values.
# `pnpm setup:secrets` writes .env and fills every secret with a random value.

# Postgres superuser password for the grc-postgres container (D13).
POSTGRES_PASSWORD=

# Neo4j accounts our code uses (D57, D73).
NEO4J_ADMIN_PASSWORD=
NEO4J_WRITER_PASSWORD=

# The Neo4j Desktop `neo4j` account's password. You fill this in yourself;
# setup:secrets leaves it empty. Only `pnpm setup:neo4j` uses it.
NEO4J_DESKTOP_PASSWORD=
