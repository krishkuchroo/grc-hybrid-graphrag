{
  "name": "grc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:db && pnpm test:stack",
    "test:unit": "pnpm -r --workspace-concurrency=1 test:unit",
    "test:db": "pnpm test:env && pnpm -r --workspace-concurrency=1 test:db",
    "test:stack": "pnpm test:env && pnpm -r --workspace-concurrency=1 test:stack",
    "test:e2e": "pnpm --filter @grc/web playwright test",
    "setup:secrets": "node packages/infra/scripts/setup-secrets.ts",
    "setup:neo4j": "node packages/infra/scripts/setup-neo4j.ts",
    "test:env": "node packages/infra/scripts/test-env.ts",
    "org:create": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/infra/scripts/create-org.ts",
    "org:admin-password": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/infra/scripts/org-admin-password.ts",
    "graph:schema": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/infra/scripts/graph-schema.ts",
    "frameworks:load": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/infra/scripts/frameworks-load.ts",
    "graph:leftovers": "node packages/infra/scripts/leftover-org-databases.ts",
    "seed:demo": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/infra/scripts/seed-demo.ts",
    "gen:data": "node --experimental-transform-types --disable-warning=ExperimentalWarning --use-system-ca packages/infra/scripts/gen-data.ts",
    "bench:questions": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/infra/scripts/bench-questions.ts",
    "train:data": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/infra/scripts/train-data.ts",
    "bench:run": "node --experimental-transform-types --disable-warning=ExperimentalWarning --use-system-ca packages/infra/scripts/bench-run.ts",
    "dataset:load": "node --experimental-transform-types --disable-warning=ExperimentalWarning --use-system-ca packages/infra/scripts/dataset-load.ts",
    "dataset:score": "node --experimental-transform-types --disable-warning=ExperimentalWarning --use-system-ca packages/infra/scripts/dataset-score.ts",
    "eval:questions": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/infra/scripts/eval-questions.ts",
    "gen:api-client": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/web/scripts/gen-api-client.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
